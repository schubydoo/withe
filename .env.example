# Local development configuration. Copy to .env: cp .env.example .env
#
# `next dev` reads this file automatically. The worker reads the ambient
# environment, so start it with: node --env-file=.env src/worker/main.ts

# Required: point Withe at your Renovate CE server.
WITHE_CE_URL=https://renovate.example.lan
WITHE_CE_TOKEN=your-MEND_RNV_API_SERVER_SECRET-value

# Local database. The default (/data/withe.db) is the container path and is not
# writable in a checkout, so dev uses a local file.
WITHE_DB_PATH=./dev.db

# Optional: HTTP basic authentication (set both to enable). See docs/exposure.md.
# WITHE_AUTH_USER=admin
# WITHE_AUTH_PASS=change-me

# Optional: TLS termination (set both to enable). See docs/exposure.md.
# WITHE_TLS_CERT=/path/to/cert.pem
# WITHE_TLS_KEY=/path/to/key.pem

# Optional: silence the no-password warning when access is controlled in front
# of Withe (reverse proxy, gateway, tailnet). Hides the warning; adds no
# protection. See docs/exposure.md.
# WITHE_ACKNOWLEDGE_EXPOSURE=true

# Optional: read live pull-request state from GitHub, so a merged Renovate pull
# request leaves the dashboard within one sync instead of waiting for Renovate's
# next run. Set the token to turn this on. A fine-grained token with read-only
# access to pull requests and commit statuses is enough. Withe never persists it.
# WITHE_GITHUB_TOKEN=github_pat_...
# Optional: a GitHub Enterprise Server API base. Defaults to github.com. Also
# set this for a jsonlog source, which cannot report its own forge: Withe reads
# live state only for a source it knows is on GitHub, or one whose host you name.
# WITHE_GITHUB_API_URL=https://ghe.example/api/v3
# Optional: the Renovate branch prefix, if you changed it from the default.
# WITHE_RENOVATE_BRANCH_PREFIX=renovate/
# Optional: extra pull-request author logins that count as Renovate, comma
# separated. `renovate[bot]` and `renovate` are always included.
# WITHE_RENOVATE_PR_AUTHORS=my-renovate-app[bot]
