{
  "name": "withe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A dashboard for the Renovate you already run.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && npm run build:static",
    "build:static": "rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/static",
    "bundle:server": "node scripts/bundle-server.ts",
    "build:client": "npx --yes openapi-typescript@7.13.0 spec/openapi-community.yaml -o src/adapters/ce/generated/ce.d.ts",
    "check:payloads": "node scripts/check-payloads.ts",
    "check:image": "node scripts/check-image.ts",
    "check:network": "node scripts/check-network.ts",
    "check:licences": "node scripts/check-licenses.ts",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && npm run restart",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "e2e": "node test/e2e/run.ts",
    "e2e:browsers": "playwright test",
    "lint": "node scripts/check-boundaries.ts",
    "perf": "node scripts/perf-measure.ts",
    "check:contention": "node scripts/check-contention.ts",
    "restart": "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} systemctl --user restart withe",
    "spec:fetch": "curl -fsSL https://raw.githubusercontent.com/mend/renovate-ce-ee/main/docs/openapi-community.yaml -o spec/openapi-community.yaml",
    "start": "next start",
    "supervisor": "node src/supervisor/main.ts",
    "sync": "node src/worker/main.ts --once",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "worker": "node src/worker/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
