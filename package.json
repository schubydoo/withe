{
  "name": "withe",
  "version": "0.0.0",
  "private": true,
  "description": "A dashboard for the Renovate you already run.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "build:client": "npx --yes openapi-typescript@7.13.0 spec/openapi-community.yaml -o src/adapters/ce/generated/ce.d.ts",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "spec:fetch": "curl -fsSL https://raw.githubusercontent.com/mend/renovate-ce-ee/main/docs/openapi-community.yaml -o spec/openapi-community.yaml",
    "start": "next start",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
